# Server
NODE_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments?schema=public

# Redis (used by BullMQ for the mail queue and other background jobs)
REDIS_URL=redis://localhost:6379
MAIL_QUEUE_CONCURRENCY=5

# JWT / cookies
JWT_ACCESS_SECRET=change-me-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=localhost
BCRYPT_COST=12

# Mailer
# console = log emails to stdout (dev), gmail = real Gmail SMTP, json = jsonTransport (tests)
MAIL_TRANSPORT=console
MAIL_FROM="Appointments <noreply@example.com>"
SMTP_USER=
SMTP_PASS=

# Admin bootstrap (used by `npm run db:seed`)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
ADMIN_BOOTSTRAP_NAME=Administrator

# Meeting (WebRTC signaling)
# MEETING_JWT_SECRET signs short-lived (5 min) join tokens — must be >=16 chars
MEETING_JWT_SECRET=change-me-meeting-secret-please
MEETING_JOIN_BEFORE_MINS=10
MEETING_JOIN_AFTER_MINS=30
# Optional TURN server (leave blank for STUN-only). All three TURN_* vars are optional.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
